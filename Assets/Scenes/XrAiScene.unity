    Value: meta/llama-3.2-90b-vision-instruct
  - Key: presencePenalty
    Scope: 1
    IsRequired: 0
    DefaultValue: 0.0
    Description: Presence penalty for the response
    Value: 0.0
  - Key: prompt
    Scope: 1
    IsRequired: 0
    DefaultValue: Describe the image

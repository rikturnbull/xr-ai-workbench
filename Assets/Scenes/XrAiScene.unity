  - Key: frequencyPenalty
    Scope: 1
    IsRequired: 0
    DefaultValue: 0.0
    Description: Frequency penalty for the response
    Value: 0.0
  - Key: imageQuality
    Scope: 1
    IsRequired: 0
    DefaultValue: 100
    Description: JPEG quality (1-100, lower = smaller file)
    Value: 100
  - Key: maxImageDimension
    Scope: 1
    IsRequired: 0
    DefaultValue: 512
    Description: Maximum width or height for the image before encoding (e.g., 128,
      256, 384)
    Value: 512
  - Key: maxTokens
    Scope: 1
    IsRequired: 0
    DefaultValue: 512
    Description: Maximum number of tokens in the response
    Value: 512
  - Key: model
    Scope: 1
    IsRequired: 0
    DefaultValue: meta/llama-3.2-90b-vision-instruct

  - Key: temperature
    Scope: 1
    IsRequired: 0
    DefaultValue: 1.0
    Description: Sampling temperature for the response
    Value: 1.0
  - Key: topP
    Scope: 1
    IsRequired: 0
    DefaultValue: 1.0
